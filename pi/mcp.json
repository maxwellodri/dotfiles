{
	"mcpServers": {
		"playwright": {
			"command": "npx",
			"args": [
				"@playwright/mcp@0.0.78",
				"--config",
				"playwright-config.json"
			],
			"cwd": "${dotfiles}/.pi/skills/capitalism"
		},
		"blender": {
			"command": "uv",
			"args": ["run", "blender-mcp"],
			"cwd": "${dotfiles}/uv",
			"env": {
				"UV_PYTHON_PREFERENCE": "only-managed",
				"DISABLE_TELEMETRY": "true"
			},
			"lifecycle": "lazy"
		}
	}
}
