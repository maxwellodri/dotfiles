# Pi runtime artifacts — PI_CODING_AGENT_DIR points at this dir, so pi writes
# runtime state here. Keep all of it out of the repo; only managed config
# (settings.json, mcp.json, extensions/, themes/) is committed.
trust.json
auth.json
npm/
packages/
sessions/
*.log

# Provider catalog cache (pi refreshes + rewrites checkedAt at runtime).
models-store.json

# Node deps a future extension might vendor locally.
node_modules/
