#!/usr/bin/env python3
"""clipown [mimetype] — read bytes from stdin and own the X11/Wayland
clipboard serving that MIME type until another app takes ownership.

Qt selection owners handle INCR for any size (xclip 0.13 serves nothing
over ~1MB) and are read correctly by Electron/Chromium apps
(signalapp/Signal-Desktop#6554).

  shot.png | clipown image/png
  clipown text/plain < notes.txt
"""
import signal
import sys

try:
    from PyQt6.QtCore import QMimeData, QByteArray
    from PyQt6.QtWidgets import QApplication
    from PyQt6.QtGui import QClipboard
except ImportError:
    print("clipown: PyQt6 not available", file=sys.stderr)
    sys.exit(1)

MIME_ALIASES = {
    "image/png": ["image/png", "image/x-png"],
    "text/plain": ["text/plain", "text/plain;charset=utf-8", "UTF8_STRING", "STRING", "TEXT"],
}


def main() -> int:
    mime = sys.argv[1] if len(sys.argv) > 1 else "text/plain"
    data = sys.stdin.buffer.read()
    if not data:
        print("clipown: no data on stdin", file=sys.stderr)
        return 1

    signal.signal(signal.SIGINT, signal.SIG_DFL)
    app = QApplication(sys.argv[:1])

    md = QMimeData()
    raw = QByteArray(data)
    md.setData(mime, raw)
    for alias in MIME_ALIASES.get(mime, []):
        md.setData(alias, raw)

    clip = QApplication.clipboard()
    clip.setMimeData(md, QClipboard.Mode.Clipboard)
    clip.setMimeData(md, QClipboard.Mode.Selection)

    # the first dataChanged is our own setMimeData; any later one means
    # another app owns the clipboard now — quit so owners don't accumulate
    import itertools
    emissions = itertools.count()
    clip.dataChanged.connect(lambda: next(emissions) and app.quit())
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
