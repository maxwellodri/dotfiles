#!/usr/bin/env bash
# Spawn wezterm with a unique class for per-window swallow matching
CLASS_ID="wezterm-$(head -c 8 /dev/urandom | xxd -p)"
export WEZTERM_CLASS_ID="$CLASS_ID"
# --class is a `start` subcommand flag; strip caller's leading "start" to avoid a double subcommand
args=("$@")
[ "${args[0]:-}" = start ] && args=("${args[@]:1}")
# -u TMUX: new window is outside tmux; leaked var confuses TMUX-aware tools (qz, fzf)
exec env -u TMUX -u TMUX_PANE wezterm start --class "$CLASS_ID" "${args[@]}"
