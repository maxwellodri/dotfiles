#!/usr/bin/env bash
# Pi launcher wrapper.
set -euo pipefail

: "${dotfiles:?pi wrapper: \$dotfiles is not set (source your shell rc).}"

export PI_CODING_AGENT_DIR="$dotfiles/pi"
export PI_CODING_AGENT_SESSION_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/pi/sessions"
# Where /archive (pi/extensions/archive.ts) retires finished threads
export PI_CODING_AGENT_ARCHIVED_SESSION_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/pi/archived_sessions"
# Agent-spawned curl picks up pi/.curlrc (descriptive UA; crates.io 403s bare
# curl/VER). CURL_HOME is curl's only env-var hook for config; inherit-safe.
: "${CURL_HOME:=$PI_CODING_AGENT_DIR}"
export CURL_HOME
#Ensure that private repo has symlinked pi sessions (live + archived)
if [ ! -L "$PI_CODING_AGENT_SESSION_DIR" ] || [ ! -d "$PI_CODING_AGENT_SESSION_DIR" ] \
	|| [ ! -L "$PI_CODING_AGENT_ARCHIVED_SESSION_DIR" ] || [ ! -d "$PI_CODING_AGENT_ARCHIVED_SESSION_DIR" ]; then
	echo "pi wrapper: $PI_CODING_AGENT_SESSION_DIR and $PI_CODING_AGENT_ARCHIVED_SESSION_DIR must be symlinks into ~/source/private/runtime/pi/\$dotfile_tag" >&2
	echo "run ~/source/private/install.sh to set it up (or symlink them manually)" >&2
	exit 1
fi

#Cargo / niceness limits 🥺
case "${dotfile_tag:-}" in
  hackerman) CARGO_BUILD_JOBS=2 ;;
  donnie)    CARGO_BUILD_JOBS=2 ;; #vps vcpus — tune to the plan
  *)         CARGO_BUILD_JOBS=4 ;;
esac
export CARGO_BUILD_JOBS
NICE=(nice -n 19 ionice -c 3)

if [ -z "${PI_BIN:-}" ]; then
	PI_BIN="${NIX_CONFIG_DIR:-${SOURCE:-$HOME/source}/nix_config}/dotfiles-env-result/bin/pi"
fi
if [ ! -x "$PI_BIN" ]; then
	echo "pi not installed — run ${NIX_CONFIG_DIR:-${SOURCE:-$HOME/source}/nix_config}/scripts/install_flake.sh to install" >&2
	exit 1
fi

case "${1:-}" in
	update)
		installer="$(realpath -m "${NIX_CONFIG_DIR:-${SOURCE:-$HOME/source}/nix_config}/scripts/install_flake.sh")"
		echo "pi is nix-managed — updating via $installer --update"
		exec "$installer" --update ;;
	typecheck)
		# nix-built tsc vs the nix-built pi's .d.ts (see nix_config pkgs/pi/default.nix)
		# --no-warn-dirty: the nix_config tree is routinely dirty; the flake
		# warning is noise here
		exec nix run --no-warn-dirty "${NIX_CONFIG_DIR:-$SOURCE/nix_config}"#typecheck -- "$PI_CODING_AGENT_DIR/extensions" ;;
	install|remove|uninstall|list|config|--help|-h|--version|-v)
		exec "$PI_BIN" "$@" ;;
esac

# Cached key skips the gpg round-trip for frequent respawns (nvim's pi.lua
# oneshot children export this after the first pass read).
if [ -z "${ZAI_API_KEY:-}" ]; then
	if ! ZAI_API_KEY="$(pass zai_pi_api_key)"; then
		echo "pi wrapper: failed to read 'zai_pi_api_key' from pass" >&2
		exit 1
	fi
fi

# OpenRouter serves the nvim oneshot models (gpt-oss via Groq/Cerebras
# routes); soft-fail — zai stays the required key.
if [ -z "${OPENROUTER_API_KEY:-}" ]; then
	if OPENROUTER_API_KEY="$(pass openrouter_api_key 2>/dev/null)"; then
		export OPENROUTER_API_KEY
	fi
fi

if [ -z "${OPENCODE_API_KEY:-}" ]; then
	if OPENCODE_API_KEY="$(pass zen_opencode_api_key 2>/dev/null)"; then
		export OPENCODE_API_KEY
	fi
fi

# Gruvbox canvas for to match theme.
if [ -t 1 ] && [ -z "${PI_NO_CANVAS:-}" ]; then
	clear
	# shellcheck disable=SC1003
	printf '\033]11;#282828\033\\'
	trap 'pi_registry_clear 2>/dev/null || true; clear; printf "\033]111\033\\"' EXIT INT TERM HUP
else
	trap 'pi_registry_clear 2>/dev/null || true' EXIT INT TERM HUP
fi

# Pi's APPEND_SYSTEM.md discovery is shadowing-only: a project file hides
# the global one. Flags layer instead, but any explicit flag disables
# discovery, so always pass the global, plus the project copy when present.
# Global first, then local. Nonexistent paths would be injected as literal
# text, hence the -f guards.
APPEND_FLAGS=()
if [ -f "$PI_CODING_AGENT_DIR/APPEND_SYSTEM.md" ]; then
	APPEND_FLAGS+=(--append-system-prompt "$PI_CODING_AGENT_DIR/APPEND_SYSTEM.md")
fi
if [ -f "$PWD/.pi/APPEND_SYSTEM.md" ]; then
	APPEND_FLAGS+=(--append-system-prompt "$PWD/.pi/APPEND_SYSTEM.md")
fi

# tmux snapshot registry: give this pi pane a stable session id so
# snapshot.sh can record pi:<uuid> for it and restore.sh can resume it.
# Skipped outside tmux; a caller-picked session (--session/--fork/…) joins
# the registry when its id is knowable, else stays out (pane restores as a
# shell next snapshot).
pi_registry="${XDG_STATE_HOME:-$HOME/.local/state}/tmux/pi_registry"
pi_reg_uuid=""
pi_reg_ident() {
	printf '%s:%s' "$(cut -c1-8 /proc/sys/kernel/random/boot_id 2>/dev/null || echo noboot)" \
		"$(printf '%s' "${TMUX:-}" | cut -d, -f2)"
}
pi_registry_write() {
	mkdir -p "$(dirname "$pi_registry")"
	local ident="$(pi_reg_ident)"
	# replace this pane's row; drop rows whose session file no longer exists
	awk -F'\t' -v OFS='\t' -v i="$ident" -v k="${TMUX_PANE:-}" -v u="$pi_reg_uuid" \
		-v sdir="$PI_CODING_AGENT_SESSION_DIR" '
		BEGIN { ufile = sdir "/_" u ".jsonl" }
		function dead(row) { split(row, f, "\t"); return (system("[ ! -e " sdir "/*_" f[3] ".jsonl ]") == 0) }
		($1 == i && $2 == k) { next }
		!dead($0) { print }
	' "$pi_registry" 2>/dev/null > "$pi_registry.tmp.$$" || true
	printf '%s\t%s\t%s\n' "$ident" "${TMUX_PANE:-}" "$pi_reg_uuid" >> "$pi_registry.tmp.$$"
	mv -f "$pi_registry.tmp.$$" "$pi_registry"
}
pi_registry_clear() {
	[ -n "$pi_reg_uuid" ] || return 0
	[ -f "$pi_registry" ] || return 0
	local ident="$(pi_reg_ident)"
	awk -F'\t' -v OFS='\t' -v i="$ident" -v k="${TMUX_PANE:-}" \
		'!($1 == i && $2 == k)' "$pi_registry" > "$pi_registry.tmp.$$" || true
	mv -f "$pi_registry.tmp.$$" "$pi_registry"
}
if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
	pi_pick=""
	for a in "$@"; do
		case "$a" in
			--) break ;;
			--session-id|--session) pi_pick="$a" ;;
			--continue|-c|--resume|-r|--fork) pi_pick=unknown; break ;;
			-*) ;;  # other flags: keep scanning
			*) break ;;  # first positional: option section over
		esac
	done
	if [ -n "$pi_pick" ]; then
		# join the registry with the caller-picked id when it is the next arg
		prev=""
		for a in "$@"; do
			case "$a" in --) break ;; esac
			if [ "$prev" = "--session-id" ] || [ "$prev" = "--session" ]; then
				pi_reg_uuid="${a%.jsonl}"
				break
			fi
			case "$a" in -*) ;; *) break ;; esac
			prev="$a"
		done
	else
		pi_reg_uuid="$(cat /proc/sys/kernel/random/uuid)"
		set -- --session-id "$pi_reg_uuid" "$@"
	fi
	[ -n "$pi_reg_uuid" ] && pi_registry_write
fi

# Run pi (child, not exec) so the trap fires on its return. Pass --session-dir
# explicitly (highest precedence; reliable across pi versions). Registry row
# is cleared on exit: pi no longer runs in this pane.
rc=0
ZAI_API_KEY="$ZAI_API_KEY" "${NICE[@]}" "$PI_BIN" --session-dir "$PI_CODING_AGENT_SESSION_DIR" "${APPEND_FLAGS[@]}" "$@" || rc=$?
pi_registry_clear
exit "$rc"
