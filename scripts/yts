#!/usr/bin/env python3
"""yts — transcribe a video/audio file or URL, optionally summarise with pi.

Local files (and URLs without captions) are transcribed by whisper.cpp
(Vulkan GPU) inside the nix devshell at $dotfiles/nix/whisper. URLs that
already have captions take the fast path: yt-dlp subtitle download, no
transcription.

Examples:
  yts video.mp4                     # plain-text transcript
  yts https://www.youtube.com/...   # captions if available, else whisper
  yts --model small talk.mp3        # bigger whisper model (auto-downloaded)
  yts --no-subs <url>               # skip caption fetch, always transcribe
  yts video.mp4 | summarize         # summarise the transcript with pi
"""

import argparse
import os
import re
import subprocess
import sys
import tempfile
import urllib.request
from pathlib import Path

# --- $dotfiles guard: transcription env (nix/whisper) and the pi wrapper live there ---
_dotfiles = os.environ.get("dotfiles", "")
if not _dotfiles or not Path(_dotfiles).is_dir():
    print("yts: error: $dotfiles is not set or not a directory (source your shell rc).",
          file=sys.stderr)
    sys.exit(1)
DOTFILES = Path(_dotfiles)

NIX_SHELL = ["nix", "develop", str(DOTFILES / "nix" / "whisper"), "-c"]

# whisper.cpp models: pacman-managed base.en when present, else auto-download
# ggml-<model>.bin from ggerganov/whisper.cpp into the cache dir.
SYSTEM_MODEL = Path("/usr/share/whisper.cpp-model-base.en/ggml-base.en.bin")
DEFAULT_MODEL = "base.en"
MODEL_CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "whisper.cpp"
MODEL_URL = "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-{model}.bin"


def die(msg: str) -> None:
    print(f"yts: error: {msg}", file=sys.stderr)
    sys.exit(1)


def run(cmd: list[str]) -> subprocess.CompletedProcess:
    """Run a tool (whisper-cli/ffmpeg/yt-dlp) inside the nix devshell."""
    return subprocess.run(NIX_SHELL + cmd, capture_output=True, text=True)


# --- whisper.cpp transcription ---


def resolve_model(name: str) -> Path:
    """Accept an explicit model path, else the system model, else cache/download."""
    p = Path(name)
    if p.is_file():
        return p
    if name == DEFAULT_MODEL and SYSTEM_MODEL.is_file():
        return SYSTEM_MODEL
    cached = MODEL_CACHE / f"ggml-{name}.bin"
    if not cached.is_file():
        MODEL_CACHE.mkdir(parents=True, exist_ok=True)
        download_model(name, cached)
    return cached


def download_model(name: str, dest: Path) -> None:
    """Stream ggml-<name>.bin to dest with progress, timeout and retry."""
    url = MODEL_URL.format(model=name)
    tmp = dest.with_suffix(".part")
    print(f"yts: downloading whisper model '{name}' ({url})", file=sys.stderr)
    last_err: Exception | None = None
    for attempt in range(1, 4):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "yts"})
            with urllib.request.urlopen(req, timeout=60) as resp, open(tmp, "wb") as f:
                total = int(resp.headers.get("Content-Length") or 0)
                done = 0
                while True:
                    chunk = resp.read(1 << 20)
                    if not chunk:
                        break
                    f.write(chunk)
                    done += len(chunk)
                    if total:
                        print(f"\r  {done / 1e6:.0f}/{total / 1e6:.0f} MB",
                              end="", file=sys.stderr, flush=True)
            print(file=sys.stderr)
            tmp.rename(dest)
            return
        except Exception as e:
            last_err = e
            print(f"\nyts: download attempt {attempt}/3 failed: {e}", file=sys.stderr)
    tmp.unlink(missing_ok=True)
    die(f"failed to download model '{name}': {last_err}")


def extract_audio(src: str, dst: str) -> None:
    print(f"yts: extracting audio to {dst} ...", file=sys.stderr)
    r = run(["ffmpeg", "-y", "-i", src, "-vn", "-ar", "16000", "-ac", "1",
             "-c:a", "pcm_s16le", dst])
    if r.returncode != 0:
        die(f"ffmpeg failed:\n{r.stderr}")


def transcribe_audio(wav: str, model: str, lang: str | None) -> str:
    model_path = resolve_model(model)
    cmd = ["whisper-cli", "-m", str(model_path), "-f", wav, "-np", "-nt"]
    if lang:
        cmd += ["-l", lang]
    print(f"yts: transcribing with whisper.cpp ({model}) ...", file=sys.stderr)
    r = run(cmd)
    if r.returncode != 0:
        die(f"whisper-cli failed:\n{r.stderr}")
    return "\n".join(line.strip() for line in r.stdout.splitlines() if line.strip())


def transcribe_file(path: str, args) -> tuple[str, str]:
    """Local media file -> (transcript, display name)."""
    with tempfile.TemporaryDirectory(prefix="yts-") as tmp:
        wav = os.path.join(tmp, "audio16k.wav")
        extract_audio(path, wav)
        transcript = transcribe_audio(wav, args.model, args.lang)
    return transcript, Path(path).name


# --- caption fetch via yt-dlp + VTT parsing (mirrors fabric's behaviour) ---

_VTT_TAG_RE = re.compile(r"<[^>]*>")
_VTT_TS_LINE_RE = re.compile(r"^\d+$|^\d{1,2}:\d{2}(:\d{2})?(\.\d{3})?$")
TIME_GAP_FOR_REPEATS = 10  # seconds; repeats after this gap are kept


def _vtt_timestamp_to_seconds(ts: str) -> int | None:
    parts = ts.split(":")
    if len(parts) < 2 or len(parts) > 3:
        return None
    try:
        if len(parts) == 3:
            hours, minutes, seconds = int(parts[0]), int(parts[1]), int(parts[2])
        else:
            hours, minutes, seconds = 0, int(parts[0]), int(parts[1])
    except ValueError:
        return None
    return hours * 3600 + minutes * 60 + seconds


def vtt_to_timestamped_text(content: str) -> str:
    """Parse VTT subtitle content into '[HH:MM:SS] text' lines."""
    seen: dict[str, str] = {}  # text -> last timestamp it appeared at
    current_ts = ""
    out: list[str] = []
    for raw in content.split("\n"):
        line = raw.strip()
        if not line or line == "WEBVTT":
            continue
        if line.startswith(("NOTE", "STYLE", "Kind:", "Language:")):
            continue
        if "-->" in line:
            current_ts = line.split(" --> ")[0].split(".")[0]
            continue
        # Skip bare numeric cue identifiers (no colon).
        if _VTT_TS_LINE_RE.match(line) and ":" not in line:
            continue
        text = _VTT_TAG_RE.sub("", line).strip()
        if not text or not current_ts:
            continue
        include = True
        if text in seen:
            last = _vtt_timestamp_to_seconds(seen[text])
            now = _vtt_timestamp_to_seconds(current_ts)
            if last is not None and now is not None and (now - last) < TIME_GAP_FOR_REPEATS:
                include = False
        if include:
            out.append(text)
            seen[text] = current_ts
    return "\n".join(out).strip()


def _find_vtt(directory: str, lang: str | None = None) -> str | None:
    paths = [p for p in Path(directory).rglob("*") if p.suffix.lower() == ".vtt"]
    if not paths:
        return None
    if lang:
        for p in paths:
            if f".{lang}." in p.name.lower():
                return str(p)
    return str(paths[0])


def fetch_url_captions(url: str, lang: str | None) -> tuple[str, str] | None:
    """Try to fetch existing subtitles. Returns (transcript, title) or None."""
    lang = lang or "en"
    lang_match = lang[:2]
    lang_opts = f"{lang},{lang_match}.*"
    if lang_match != lang:
        lang_opts += f",{lang_match}"
    with tempfile.TemporaryDirectory(prefix="yts-subs-") as tmp:
        out_tmpl = os.path.join(tmp, "%(title)s.%(ext)s")

        def run_ytdlp(with_lang: bool) -> None:
            cmd = ["yt-dlp", "--write-subs", "--write-auto-subs", "--skip-download",
                   "--sub-format", "vtt", "--no-playlist", "-o", out_tmpl]
            if with_lang:
                cmd += ["--sub-langs", lang_opts]
            cmd.append(url)
            run(cmd)

        run_ytdlp(with_lang=True)
        vtt = _find_vtt(tmp, lang)
        if vtt is None:
            # Retry without a language restriction to grab any available subs.
            run_ytdlp(with_lang=False)
            vtt = _find_vtt(tmp)
        if vtt is None:
            return None
        content = Path(vtt).read_text(encoding="utf-8", errors="replace")
        transcript = vtt_to_timestamped_text(content)
    if not transcript:
        return None
    return transcript, Path(vtt).stem


def transcribe_url(url: str, args) -> tuple[str, str]:
    """URL -> (transcript, display name). Captions if available, else whisper."""
    if not args.no_subs:
        print(f"yts: checking for captions: {url}", file=sys.stderr)
        caps = fetch_url_captions(url, args.lang)
        if caps is not None:
            return caps
        print("yts: no captions found, falling back to transcription.", file=sys.stderr)
    else:
        print(f"yts: --no-subs, downloading audio: {url}", file=sys.stderr)
    with tempfile.TemporaryDirectory(prefix="yts-audio-") as tmp:
        out_tmpl = os.path.join(tmp, "%(title)s.%(ext)s")
        r = run(["yt-dlp", "-f", "bestaudio/best", "--no-playlist", "-o", out_tmpl, url])
        if r.returncode != 0:
            die(f"yt-dlp failed:\n{r.stderr}")
        media = [p for p in Path(tmp).iterdir() if p.is_file()]
        if not media:
            die("yt-dlp produced no output file.")
        wav = os.path.join(tmp, "audio16k.wav")
        extract_audio(str(media[0]), wav)
        transcript = transcribe_audio(wav, args.model, args.lang)
    return transcript, media[0].stem


# --- summary lives in scripts/summarize (pipes text to headless pi) ---


def main():
    parser = argparse.ArgumentParser(
        description="Transcribe a video/audio file or URL (whisper.cpp via nix shell).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Environment: YTS_LANG (language default for transcription and captions)."
    )
    parser.add_argument("input", nargs="?", help="URL or path to audio/video file")
    parser.add_argument("--model", default=DEFAULT_MODEL,
                        help=f"whisper model name or path (default: {DEFAULT_MODEL})")
    parser.add_argument("--lang", default=os.environ.get("YTS_LANG"),
                        help="language hint for transcription and captions (e.g. en, auto)")
    parser.add_argument("--no-subs", action="store_true",
                        help="skip caption fetch for URLs; always transcribe audio")
    parser.add_argument("--download-model", action="store_true",
                        help="ensure the whisper model is downloaded/local, then exit")
    args = parser.parse_args()

    if args.download_model:
        model_path = resolve_model(args.model)
        print(f"Model ready: {model_path}")
        return

    input_val = args.input
    if not input_val:
        r = subprocess.run(["clipboard"], capture_output=True, text=True)
        input_val = r.stdout.strip()
        if not input_val:
            die("no input given and clipboard is empty.")

    if input_val.startswith(("http://", "https://")):
        transcript, name = transcribe_url(input_val, args)
    elif os.path.isfile(input_val):
        transcript, name = transcribe_file(input_val, args)
    else:
        die(f"not a URL or existing file: {input_val}")

    if not transcript:
        die("transcription produced no output.")

    print(transcript)


if __name__ == "__main__":
    main()
