#!/usr/bin/env bash
# await_pipe — block until trigger_pipe latches the same name; returns instantly
# if that trigger already fired (no listener needed at fire time).

help() {
	cat <<'EOF'
await_pipe <name> — wait for trigger_pipe <name>, then exit 0.

	await_pipe afk && do_afk_work
	AWAIT_TIMEOUT_S=30m await_pipe afk   # give up after 30 min (GNU timeout duration)

Returns instantly when the signal was latched earlier; one await consumes one
latch, so the next await_pipe blocks until triggered again. Latches live in
${XDG_RUNTIME_DIR:-/run/user/<uid>}/agent-signals/ (tmpfs: an unawaited latch
survives until logout/reboot).
Exit codes: 0 signal received, 124 timed out (only with AWAIT_TIMEOUT_S set),
1 bad usage. Ctrl-C aborts.
EOF
}

case "${1:-}" in
	-h | --help) help; exit 0 ;;
esac
if [ $# -ne 1 ]; then
	echo "usage: await_pipe <name> (see --help)" >&2
	exit 1
fi

name=$1
case "$name" in
	*/*) echo "await_pipe: bad pipe name: $name" >&2; exit 1 ;;
esac

flag="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agent-signals/$name.signaled"
mkdir -p "$(dirname "$flag")"

# mv is the atomic claim: exactly one await consumes the latch
timeout "${AWAIT_TIMEOUT_S:-infinity}" bash -c '
	until mv "$1" "$1.claimed.$$" 2>/dev/null; do
		sleep 0.1
	done
	rm -f "$1.claimed.$$"
	printf "signal received: %s\n" "$1"
' bash "$flag"
