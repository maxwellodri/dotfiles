#!/usr/bin/env python3
"""Queue files/directories in mpv.

Modes:
  r  shuffled; directories with no subdirectories play as one contiguous
     sorted block, directories with subdirectories are shuffled recursively
  o  directory: newest first / piped: order as received
  i  directory: oldest first / piped: reverse order as received

Input is a directory argument (default: cwd) or a list of paths on
stdin, newline- or NUL-separated. Exact duplicates and paths nested
inside another given directory are dropped; mpv expands remaining
directory entries into the playlist itself.
"""
import argparse
import os
import random
import subprocess
import sys

JUNK_EXTENSIONS = ('.part', '.ytdl', '.json')


def is_playable_file(path):
    return os.path.isfile(path) and not path.endswith(JUNK_EXTENSIONS)


def top_level_entries(directory):
    """Playable files and all subdirectories directly inside directory."""
    entries = []
    for name in os.listdir(directory):
        path = os.path.join(directory, name)
        if os.path.isdir(path) or is_playable_file(path):
            entries.append(path)
    return entries


def has_subdirectory(directory):
    return any(os.path.isdir(os.path.join(directory, name))
               for name in os.listdir(directory))


def shuffled_playlist(paths):
    """Shuffle paths at each directory level.

    Leaf directories are kept as single entries so mpv expands them in
    place: contiguous, in sorted order. Directories that contain further
    directories are expanded here and their children shuffled instead.
    """
    units = []
    for path in paths:
        if os.path.isdir(path) and has_subdirectory(path):
            units.append(shuffled_playlist(top_level_entries(path)))
        else:
            units.append(path)
    random.shuffle(units)
    return [entry for unit in units
            for entry in (unit if isinstance(unit, list) else [unit])]


def dedupe_paths(paths):
    """Drop exact duplicates and paths nested inside another given directory."""
    resolved_paths = []
    seen = set()
    for path in paths:
        resolved = os.path.realpath(path)
        if resolved not in seen:
            seen.add(resolved)
            resolved_paths.append(resolved)
    directories = [p for p in resolved_paths if os.path.isdir(p)]
    return [p for p in resolved_paths
            if not any(p != d and p.startswith(d + os.sep) for d in directories)]


def read_piped_paths():
    """Paths from stdin (newline- or NUL-separated); None if stdin is a
    terminal or empty, so non-interactive callers fall back to the
    directory walk."""
    if sys.stdin is None or sys.stdin.isatty():
        return None
    data = sys.stdin.read()
    if not data.strip():
        return None
    separator = '\0' if '\0' in data else '\n'
    return [line.strip() for line in data.split(separator) if line.strip()]


def directory_playlist(directory):
    if not os.path.isdir(directory):
        print(f"Error: {directory} is not a directory.", file=sys.stderr)
        sys.exit(1)
    return top_level_entries(directory)


def piped_playlist(paths):
    existing = []
    for path in paths:
        if os.path.exists(path):
            existing.append(path)
        else:
            print(f"Skipping missing path: {path}", file=sys.stderr)
    return existing


def play(playlist):
    if not playlist:
        print("Nothing to play.", file=sys.stderr)
        sys.exit(1)
    try:
        result = subprocess.run(["mpv", "--"] + playlist)
    except KeyboardInterrupt:
        sys.exit(130)
    sys.exit(result.returncode)


def main():
    parser = argparse.ArgumentParser(description="Queue files in mpv.")
    parser.add_argument("-m", "--mode", choices=['r', 'o', 'i'], required=True,
                        help="r: shuffled (leaf dirs play as contiguous sorted "
                             "blocks), o: newest first (piped: order as "
                             "received), i: oldest first (piped: reversed)")
    parser.add_argument("directory", nargs='?', default=None,
                        help="Directory to play from (defaults to current "
                             "directory); ignored when paths are piped on stdin")
    args = parser.parse_args()

    piped = read_piped_paths()
    if piped is not None:
        if args.directory:
            print("Piped paths take precedence over directory argument.",
                  file=sys.stderr)
        paths = dedupe_paths(piped_playlist(piped))
        if args.mode == 'r':
            playlist = shuffled_playlist(paths)
        elif args.mode == 'o':
            playlist = paths
        else:
            playlist = list(reversed(paths))
    else:
        paths = dedupe_paths(directory_playlist(args.directory or os.getcwd()))
        if args.mode == 'r':
            playlist = shuffled_playlist(paths)
        else:
            playlist = sorted(paths, key=os.path.getmtime,
                              reverse=(args.mode == 'o'))

    play(playlist)


if __name__ == "__main__":
    main()
