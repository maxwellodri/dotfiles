#!/bin/sh

SOUND_FILE="${dotfiles:-$HOME/source/dotfiles}/media/camera.ogg"
dotdir="${dotfiles:-$HOME/source/dotfiles}"

if [ ! -f "$SOUND_FILE" ]; then
    notify-send "Camera sound file not found"
    exit 1
fi

if [ "$1" != "selfexec" ]; then
    exec setsid "$0" selfexec "$@"
fi

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
mkdir -p "$cache_dir"
LOCKFILE="/tmp/screenshot-$USER.lock"

# Detect display server
if [ -n "$WAYLAND_DISPLAY" ]; then
    SESSION_TYPE="wl"
elif [ -n "$DISPLAY" ]; then
    SESSION_TYPE="x11"
else
    notify-send "Cannot detect display server"
    exit 1
fi

# xclip 0.13 silently serves nothing for selections over ~1MB (broken INCR
# path) — fallback only, used when clipown (PyQt6) is unavailable.
shrink_for_xclip() {
    [ "$(stat -c%s "$1")" -le 800000 ] && return 0
    for colors in 255 64 32; do
        magick "$1" -dither None -colors $colors "$1.tmp.png" 2>/dev/null || continue
        mv "$1.tmp.png" "$1"
        [ "$(stat -c%s "$1")" -le 800000 ] && return 0
    done
    return 1
}

# clipown (Qt selection owner) serves any size via INCR and is read
# correctly by Electron apps (xclip-owned selections trip
# signalapp/Signal-Desktop#6554). Replaces any previous instance.
serve_image() {
    clipown="$dotdir/scripts/clipown"
    if [ -x "$clipown" ]; then
        pkill -f "clipown image" 2>/dev/null
        setsid "$clipown" image/png < "$1" >/dev/null 2>&1 &
    else
        xclip -t 'image/png' -selection clipboard < "$1"
        if shrink_for_xclip "$1"; then
            xclip -t image/png -selection clipboard < "$1"
        fi
    fi
}

# geometry of the RandR output containing the pointer
current_monitor_geometry() {
    eval "$(xdotool getmouselocation --shell 2>/dev/null)"
    [ -n "${X:-}" ] || { echo; return 1; }
    xrandr --query | awk -v px="$X" -v py="$Y" '
        / connected/ {
            for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) {
                split($i, a, "+"); split(a[1], d, "x")
                if (px >= a[2] && px < a[2] + d[1] && py >= a[3] && py < a[3] + d[2]) { print $i; exit }
            }
        }'
}

if [ -f "$LOCKFILE" ]; then
    old_pid=$(cat "$LOCKFILE")
    kill -TERM -"$old_pid" 2>/dev/null
    rm -f "$LOCKFILE"

    if [ "$SESSION_TYPE" = "wl" ]; then
        grim - | tee "$cache_dir/screenshot.png" | wl-copy --type image/png
    else
        # second invocation = "everything", scoped to the pointer's monitor
        shotgun -g "$(current_monitor_geometry)" - | tee "$cache_dir/screenshot.png" > /dev/null
        serve_image "$cache_dir/screenshot.png"
    fi

    notify-send -t 1000 "Screenshot Taken 📸"
    setsid ffplay -nodisp -autoexit "$SOUND_FILE" &
else
    echo $$ > "$LOCKFILE"
    trap 'rm -f "$LOCKFILE"' EXIT

    if [ "$SESSION_TYPE" = "wl" ]; then
        geometry="$(slurp)"
        grim -g "$geometry" - | tee "$cache_dir/screenshot.png" | wl-copy --type image/png
    else
        selection="$(hacksaw -f "%i %g")"
        window_id="$(echo "$selection" | cut -d' ' -f1)"
        geometry="$(echo "$selection" | cut -d' ' -f2)"
        shotgun -i "$window_id" -g "$geometry" - | tee "$cache_dir/screenshot.png" > /dev/null
        serve_image "$cache_dir/screenshot.png"
    fi

    rm -f "$LOCKFILE"
fi

# Mirror clipboard to primary selection. On X11 clipown already owns both;
# only the xclip fallback path needs it — with the matching MIME type, since
# an untyped text read of an image-only clipboard hangs xclip forever.
if [ "$SESSION_TYPE" = "wl" ]; then
    wl-paste | wl-copy --primary
elif [ ! -x "${dotfiles:-$HOME/source/dotfiles}/scripts/clipown" ]; then
    timeout 3 xclip -selection clipboard -o -t image/png 2>/dev/null | \
        timeout 3 xclip -t image/png -selection primary
fi
