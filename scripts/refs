#!/usr/bin/env python3
"""refs - grab art reference images from DDG Images and arrange them on a board.

refs [-N COUNT] [-C COLS] QUERY...       download COUNT images (default 20), grid COLS wide (default 4); one query, up to 50 candidates
refs IMAGE...                            board from local image files
refs BOARD.refs                          open a saved board (zip of images + board.json)

Board keys: click=select  s/r=scale/rotate (esc cancels, enter/click confirms)
wheel=zoom canvas  empty-drag=pan  alt-drag=drag image out  drop=add  del=remove  ctrl+s=save  q=quit
Hard-killing the window (dwm super+shift+x) skips the save prompt and prints
an "X connection broken" line from Tk itself; use q for a clean quit.
Dragging an image against a window edge auto-pans. Nothing is written to disk
until you save; boards land in ~/Pictures/refs/<query>-<dd_mm_yyyy>[-n].refs
(stored zip, no compression).

Dependencies: uv/refs project (see pyproject there); the uv fallback below
re-execs into it on the system interpreter (tkinter needs it).
Search: Brave Images API, key from `pass show brave_search_api_key`.
"""
import argparse
import concurrent.futures
import io
import json
import math
import os
import re
import subprocess
import sys
import tkinter as tk
import tkinter.messagebox
import zipfile
from datetime import date
from pathlib import Path

try:
    import requests
    from PIL import Image, ImageTk
    from tkinterdnd2 import DND_FILES, DND_TEXT, TkinterDnD
except ImportError:
    project = Path(__file__).resolve().parents[1] / "uv" / "refs"
    os.execvp("uv", ["uv", "run", "--project", str(project), "--python", "/usr/bin/python3",
                     "python", os.path.abspath(__file__), *sys.argv[1:]])

BOARD_ROOT = Path.home() / "Pictures" / "refs"
DRAG_CACHE = Path.home() / ".cache" / "refs"
BRAVE_IMAGES_ENDPOINT = "https://api.search.brave.com/res/v1/images/search"
BRAVE_KEY_ENTRY = "brave_search_api_key"
USER_AGENT = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126 Safari/537.36"
MIN_EDGE = 250
MAX_EDGE = 480
EXTENSIONS = {"JPEG": "jpg", "PNG": "png", "WEBP": "webp", "GIF": "gif", "BMP": "bmp", "TIFF": "tif"}
MOD1_MASK = 0x0008  # alt on X11
EDGE_MARGIN = 24
PAN_SPEED = 20


def slugify(text):
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return slug or "refs"


# AI-generated image filtering: no search API labels AI images, so filter
# locally: generator-site markers on the result URL/title, then embedded
# generator metadata (ComfyUI/A1111 PNG chunks, C2PA manifests) on download.
AI_MARKERS = re.compile(
    r"\b(?:midjourney|stable.?diffusion|dall-?e|artbreeder|nightcafe|leonardo\.ai|ideogram|flux)\b"
    r"|\bai[- _]?(?:generated|image|art)\b|freepik\.com/(?:premium-)?ai", re.I)


def looks_ai_generated(pil, data):
    head = data[:262144]
    if b"c2pa" in head:
        return True
    for key, value in pil.info.items():
        if key in ("parameters", "workflow", "prompt"):
            return True
        if isinstance(value, str) and re.search(r"comfyui|stable.?diffusion|dall-?e", value, re.I):
            return True
    return False


def candidate_urls(query, limit):
    """Full-resolution image URLs from the Brave Images API in a single
    request (50 candidates max — enough headroom for the AI/size filters)."""
    key = subprocess.run(["pass", "show", BRAVE_KEY_ENTRY],
                         capture_output=True, text=True).stdout.strip()
    if not key:
        print(f"missing api key: pass show {BRAVE_KEY_ENTRY}", file=sys.stderr)
        sys.exit(1)
    try:
        response = requests.get(
            BRAVE_IMAGES_ENDPOINT, params={"q": query, "count": min(limit * 3, 50)},
            headers={"X-Subscription-Token": key, "Accept": "application/json"},
            timeout=10)
        response.raise_for_status()
        results = response.json().get("results", [])
    except Exception as error:
        print(f"brave images search failed: {error}", file=sys.stderr)
        return []
    seen, urls = set(), []
    for result in results:
        image = (result.get("properties") or {}).get("url")
        blob = f"{result.get('url', '')} {result.get('title', '')}"
        if image and image not in seen and not AI_MARKERS.search(blob):
            seen.add(image)
            urls.append(image)
    return urls


def download_image(url):
    try:
        response = requests.get(url, headers={"User-Agent": USER_AGENT}, timeout=10)
        response.raise_for_status()
        pil = Image.open(io.BytesIO(response.content))
        pil.load()
        if min(pil.size) < MIN_EDGE or looks_ai_generated(pil, response.content):
            return None
        return response.content, EXTENSIONS.get(pil.format, "jpg"), pil.size
    except Exception:
        return None


def make_entry(index, data, ext, size):
    return {"file": f"images/{index:04d}.{ext}",
            "x": 0, "y": 0, "scale": 1.0, "rotation": 0,
            "size": size, "data": data}


def grab(query, count, columns):
    entries = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        futures = {pool.submit(download_image, url): url
                   for url in candidate_urls(query, count * 3)}
        for future in concurrent.futures.as_completed(futures):
            if len(entries) >= count:
                for pending in futures:
                    pending.cancel()
                break
            downloaded = future.result()
            if downloaded:
                entries.append(make_entry(len(entries), *downloaded))
    if not entries:
        print("no usable images found", file=sys.stderr)
        sys.exit(1)
    layout_grid(entries, columns)
    return entries


def board_from_files(paths):
    entries = []
    for path in paths:
        data = Path(path).read_bytes()
        try:
            pil = Image.open(io.BytesIO(data))
            pil.load()
        except Exception:
            print(f"skipping unreadable image: {path}", file=sys.stderr)
            continue
        ext = EXTENSIONS.get(pil.format, Path(path).suffix.lstrip(".").lower() or "jpg")
        entries.append(make_entry(len(entries), data, ext, pil.size))
    if not entries:
        print("no readable images given", file=sys.stderr)
        sys.exit(1)
    return entries


def layout_grid(entries, columns):
    cell = 520
    cols = max(1, columns)
    for index, entry in enumerate(entries):
        col, row = index % cols, index // cols
        entry["x"] = col * cell + cell // 2
        entry["y"] = row * cell + cell // 2
        entry["scale"] = min(1.0, MAX_EDGE / max(entry["size"]))


def new_board_path(query):
    BOARD_ROOT.mkdir(parents=True, exist_ok=True)
    base = f"{slugify(query)}-{date.today().strftime('%d_%m_%Y')}"
    path, suffix = BOARD_ROOT / f"{base}.refs", 2
    while path.exists():
        path = BOARD_ROOT / f"{base}-{suffix}.refs"
        suffix += 1
    return path


def write_refs(path, query, entries):
    tmp = path.with_name(path.name + ".tmp")
    with zipfile.ZipFile(tmp, "w", zipfile.ZIP_STORED) as archive:
        archive.writestr("board.json", json.dumps(
            {"query": query,
             "images": [{key: entry[key] for key in ("file", "x", "y", "scale", "rotation")}
                        for entry in entries]},
            indent=1))
        for entry in entries:
            archive.writestr(entry["file"], entry["data"])
    tmp.replace(path)
    return path


def load_refs(path):
    with zipfile.ZipFile(path) as archive:
        board = json.loads(archive.read("board.json"))
        for entry in board["images"]:
            entry["data"] = archive.read(entry["file"])
    return board.get("query", ""), board["images"]


class RefBoard:
    """Infinite pan/zoom canvas. Entries hold world coordinates; canvas
    coordinates are world * zoom, so view zoom never mutates the layout."""

    BG = "#282828"
    HINTS = (" | click=select/drag s/r=scale/rotate wheel=zoom empty-drag=pan"
             " alt-drag=drag-out drop=add del=remove ctrl+s=save q=quit")
    PAN_RANGE = 1_000_000

    def __init__(self, board_path=None, query="", entries=None):
        self.board_path = board_path
        self.query = query
        if board_path:
            self.query, entries = load_refs(board_path)
        self.entries = []
        self.zoom = 1.0
        self.drag_entry = None
        self.drag_offset = (0, 0)
        self.panning = False
        self.focused = None
        self.focus_outline = None
        self.dirty = False
        self.modal = None
        self.modal_snapshot = None
        self.modal_anchor = (0.0, 0.0)
        self.modal_pointer = (0, 0)
        self.edge_velocity = (0, 0)
        self.edge_ticker = None
        self.fitted = False
        self.root = TkinterDnD.Tk()
        self.canvas = tk.Canvas(self.root, bg=self.BG, highlightthickness=0)
        self.canvas.pack(fill="both", expand=True)
        self.canvas.configure(scrollregion=(-self.PAN_RANGE, -self.PAN_RANGE,
                                            self.PAN_RANGE, self.PAN_RANGE))
        for entry in entries:
            entry["pil"] = Image.open(io.BytesIO(entry["data"])).convert("RGBA")
            self.place_entry(entry)
        for sequence, handler in (("<Button-1>", self.on_press),
                                  ("<Button-3>", lambda _event: self.modal_finish(False)),
                                  ("<B1-Motion>", self.on_motion),
                                  ("<ButtonRelease-1>", self.on_release),
                                  ("<Button-4>", lambda event: self.on_wheel(event, +1)),
                                  ("<Button-5>", lambda event: self.on_wheel(event, -1)),
                                  ("<MouseWheel>", lambda event: self.on_wheel(event, 1 if event.delta > 0 else -1)),
                                  ("<Configure>", self.on_configure)):
            self.canvas.bind(sequence, handler)
        # keys bind on the root: the canvas never takes keyboard focus on click
        self.root.bind("<Delete>", self.on_delete)
        self.root.bind("<Control-s>", self.save)
        self.root.bind("<q>", lambda _event: self.close())
        for key in ("s", "r", "S", "R"):
            self.root.bind(f"<{key}>", self.on_modal_key)
        self.root.bind("<Return>", lambda _event: self.modal_finish(True))
        self.root.bind("<Escape>", lambda _event: self.modal_finish(False))
        self.root.bind("<Motion>", self.on_modal_motion)
        self.canvas.drop_target_register(DND_FILES, DND_TEXT)
        self.canvas.dnd_bind("<<Drop>>", self.on_drop)
        # tkdnd only pre-binds TkDND_Drag1/2/3 tags; roll our own alt-modified one
        self.canvas.tk.call("bind", "TkDND_DragAlt", "<Alt-ButtonPress-1>",
                            "tkdnd::_begin_drag press 1 %W %s %X %Y %x %y")
        self.canvas.tk.call("bind", "TkDND_DragAlt", "<Alt-B1-Motion>",
                            "tkdnd::_begin_drag motion 1 %W %s %X %Y %x %y")
        self.canvas.tk.call("tkdnd::drag_source", "register", self.canvas._w,
                            (DND_FILES,), "Alt")
        self.canvas.dnd_bind("<<DragInitCmd>>", self.on_drag_init)
        self.root.protocol("WM_DELETE_WINDOW", self.close)
        screen = self.root.winfo_screenwidth(), self.root.winfo_screenheight()
        self.root.geometry(f"{int(screen[0] * 0.8)}x{int(screen[1] * 0.8)}+60+40")
        self.update_title()

    def place_entry(self, entry):
        self.render(entry)
        entry["item"] = self.canvas.create_image(
            entry["x"] * self.zoom, entry["y"] * self.zoom, image=entry["photo"])
        self.entries.append(entry)

    def add_entry(self, data, ext, size, x, y):
        index = max((int(Path(entry["file"]).stem) for entry in self.entries),
                    default=-1) + 1
        entry = make_entry(index, data, ext, size)
        entry["x"], entry["y"] = x, y
        entry["scale"] = min(1.0, MAX_EDGE / max(size))
        entry["pil"] = Image.open(io.BytesIO(data)).convert("RGBA")
        self.place_entry(entry)
        self.mark_dirty()

    def update_title(self):
        name = (self.board_path.name if self.board_path
                else f"{slugify(self.query)} (unsaved)")
        self.root.title(f"{'*' if self.dirty else ''}refs - {name}{self.HINTS}")

    # view ------------------------------------------------------------------

    def world_at_widget(self, x, y):
        return (self.canvas.canvasx(x) / self.zoom,
                self.canvas.canvasy(y) / self.zoom)

    def pointer_world(self):
        return self.world_at_widget(
            self.canvas.winfo_pointerx() - self.canvas.winfo_rootx(),
            self.canvas.winfo_pointery() - self.canvas.winfo_rooty())

    def render(self, entry):
        pil = entry["pil"]
        scale = entry["scale"] * self.zoom
        width = max(1, round(pil.width * scale))
        height = max(1, round(pil.height * scale))
        if (width, height) != pil.size:
            pil = pil.resize((width, height), Image.LANCZOS)
        if entry["rotation"] % 360:
            pil = pil.rotate(entry["rotation"], expand=True, resample=Image.BICUBIC,
                             fillcolor=self.BG)
        entry["photo"] = ImageTk.PhotoImage(pil, master=self.canvas)

    def recoord(self, entry):
        self.canvas.coords(entry["item"], entry["x"] * self.zoom, entry["y"] * self.zoom)

    def rerender_all(self):
        for entry in self.entries:
            self.render(entry)
            self.recoord(entry)
            self.canvas.itemconfig(entry["item"], image=entry["photo"])
        self.refresh_focus_outline()

    def region_bounds(self):
        return [float(value) for value in self.canvas.cget("scrollregion").split()]

    def set_view(self, zoom, center_x, center_y):
        self.zoom = zoom
        self.rerender_all()
        half = self.PAN_RANGE
        center = (center_x * zoom, center_y * zoom)
        region = [center[0] - half, center[1] - half, center[0] + half, center[1] + half]
        self.canvas.configure(scrollregion=region)
        origin = (center[0] - self.canvas.winfo_width() / 2,
                  center[1] - self.canvas.winfo_height() / 2)
        self.canvas.xview_moveto((origin[0] - region[0]) / (region[2] - region[0]))
        self.canvas.yview_moveto((origin[1] - region[1]) / (region[3] - region[1]))

    def world_content_bbox(self):
        if not self.entries:
            return 0.0, 0.0, 0.0, 0.0
        left = min(e["x"] - e["pil"].width * e["scale"] / 2 for e in self.entries)
        right = max(e["x"] + e["pil"].width * e["scale"] / 2 for e in self.entries)
        top = min(e["y"] - e["pil"].height * e["scale"] / 2 for e in self.entries)
        bottom = max(e["y"] + e["pil"].height * e["scale"] / 2 for e in self.entries)
        return left, top, right, bottom

    def fit_all(self):
        width, height = self.canvas.winfo_width(), self.canvas.winfo_height()
        if width < 2 or height < 2:
            return
        left, top, right, bottom = self.world_content_bbox()
        margin = 80
        zoom = max(0.02, min(1.0, (width - 2 * margin) / (right - left),
                             (height - 2 * margin) / (bottom - top)))
        self.set_view(zoom, (left + right) / 2, (top + bottom) / 2)
        self.fitted = True

    def on_configure(self, _event):
        if not self.fitted:
            self.fit_all()

    def pan_canvas_by(self, dx, dy):
        region = self.region_bounds()
        origin_x = self.canvas.canvasx(0) + dx
        origin_y = self.canvas.canvasy(0) + dy
        self.canvas.xview_moveto((origin_x - region[0]) / (region[2] - region[0]))
        self.canvas.yview_moveto((origin_y - region[1]) / (region[3] - region[1]))

    def on_wheel(self, event, direction):
        new_zoom = min(8.0, max(0.02, self.zoom * 1.15 ** direction))
        if new_zoom == self.zoom:
            return
        region = self.region_bounds()
        world_center = ((region[0] + region[2]) / 2 / self.zoom,
                        (region[1] + region[3]) / 2 / self.zoom)
        anchor = self.world_at_widget(event.x, event.y)
        self.zoom = new_zoom
        self.rerender_all()
        center = (world_center[0] * new_zoom, world_center[1] * new_zoom)
        region = [center[0] - self.PAN_RANGE, center[1] - self.PAN_RANGE,
                  center[0] + self.PAN_RANGE, center[1] + self.PAN_RANGE]
        self.canvas.configure(scrollregion=region)
        origin = (anchor[0] * new_zoom - event.x, anchor[1] * new_zoom - event.y)
        self.canvas.xview_moveto((origin[0] - region[0]) / (region[2] - region[0]))
        self.canvas.yview_moveto((origin[1] - region[1]) / (region[3] - region[1]))

    # selection -------------------------------------------------------------

    def entry_at(self, world_x, world_y):
        px, py = world_x * self.zoom, world_y * self.zoom
        for entry in reversed(self.entries):
            left, top, right, bottom = self.canvas.bbox(entry["item"])
            if left <= px <= right and top <= py <= bottom:
                return entry
        return None

    def bring_to_front(self, entry):
        self.entries.remove(entry)
        self.entries.append(entry)
        self.canvas.tag_raise(entry["item"])

    def set_focused(self, entry):
        self.focused = entry
        if self.focus_outline is not None:
            self.canvas.delete(self.focus_outline)
            self.focus_outline = None
        if entry is not None:
            self.focus_outline = self.canvas.create_rectangle(
                self.canvas.bbox(entry["item"]), outline="#fabd2f", width=2)

    def refresh_focus_outline(self):
        if self.focused is not None and self.focused in self.entries:
            self.set_focused(self.focused)

    def mark_dirty(self):
        if not self.dirty:
            self.dirty = True
            self.update_title()

    # mouse -----------------------------------------------------------------

    def on_press(self, event):
        if self.modal:
            self.modal_finish(True)
            return
        if event.state & MOD1_MASK:  # tkdnd owns the alt-drag gesture
            return
        self.canvas.focus_set()
        world_x, world_y = self.world_at_widget(event.x, event.y)
        entry = self.entry_at(world_x, world_y)
        if entry:
            self.drag_entry = entry
            self.drag_offset = (world_x - entry["x"], world_y - entry["y"])
            self.bring_to_front(entry)
            self.set_focused(entry)
            self.mark_dirty()
        else:
            self.set_focused(None)
            self.panning = True
            self.canvas.scan_mark(event.x, event.y)

    def on_motion(self, event):
        if event.state & MOD1_MASK:
            return
        if self.drag_entry:
            self.drag_entry["x"] = self.world_at_widget(event.x, event.y)[0] - self.drag_offset[0]
            self.drag_entry["y"] = self.world_at_widget(event.x, event.y)[1] - self.drag_offset[1]
            self.recoord(self.drag_entry)
            self.refresh_focus_outline()
            self.mark_dirty()
            self.update_edge_pan(event)
        elif self.panning:
            self.canvas.scan_dragto(event.x, event.y, gain=1)

    def on_release(self, _event):
        self.drag_entry = None
        self.panning = False
        self.stop_edge_pan()

    def update_edge_pan(self, event):
        width, height = self.canvas.winfo_width(), self.canvas.winfo_height()
        vx = PAN_SPEED if event.x > width - EDGE_MARGIN else -PAN_SPEED if event.x < EDGE_MARGIN else 0
        vy = PAN_SPEED if event.y > height - EDGE_MARGIN else -PAN_SPEED if event.y < EDGE_MARGIN else 0
        self.edge_velocity = (vx, vy)
        if (vx or vy) and self.edge_ticker is None:
            self.edge_ticker = self.root.after(16, self.edge_pan_tick)

    def edge_pan_tick(self):
        self.edge_ticker = None
        if not self.edge_velocity or self.edge_velocity == (0, 0):
            return
        if self.drag_entry is None:
            return
        dx, dy = self.edge_velocity
        self.pan_canvas_by(dx, dy)
        self.drag_entry["x"] += dx / self.zoom
        self.drag_entry["y"] += dy / self.zoom
        self.recoord(self.drag_entry)
        self.refresh_focus_outline()
        self.mark_dirty()
        self.edge_ticker = self.root.after(16, self.edge_pan_tick)

    def stop_edge_pan(self):
        self.edge_velocity = (0, 0)
        if self.edge_ticker is not None:
            self.root.after_cancel(self.edge_ticker)
            self.edge_ticker = None

    # blender-style modal transforms -----------------------------------------

    def on_modal_key(self, event):
        mode = {"s": "scale", "r": "rotate"}.get(event.keysym.lower())
        if mode is None or self.focused is None:
            return
        self.modal = mode
        self.modal_snapshot = {key: self.focused[key] for key in ("x", "y", "scale", "rotation")}
        self.modal_anchor = self.pointer_world()
        self.modal_pointer = (self.canvas.winfo_pointerx() - self.canvas.winfo_rootx(),
                              self.canvas.winfo_pointery() - self.canvas.winfo_rooty())

    def on_modal_motion(self, event):
        if not self.modal:
            return
        self.modal_pointer = (event.x, event.y)
        self.modal_apply()

    def modal_apply(self):
        entry, snapshot = self.focused, self.modal_snapshot
        if entry is None or snapshot is None:
            return
        world_x, world_y = self.world_at_widget(*self.modal_pointer)
        anchor_x, anchor_y = self.modal_anchor
        if self.modal == "scale":
            start = max(1.0, math.hypot(anchor_x - snapshot["x"], anchor_y - snapshot["y"]))
            now = math.hypot(world_x - snapshot["x"], world_y - snapshot["y"])
            entry["scale"] = min(20.0, max(0.01, snapshot["scale"] * now / start))
        elif self.modal == "rotate":
            start = math.atan2(anchor_y - snapshot["y"], anchor_x - snapshot["x"])
            now = math.atan2(world_y - snapshot["y"], world_x - snapshot["x"])
            entry["rotation"] = (snapshot["rotation"] - math.degrees(now - start)) % 360
        else:
            return
        self.render(entry)
        self.recoord(entry)
        self.canvas.itemconfig(entry["item"], image=entry["photo"])
        self.refresh_focus_outline()
        self.mark_dirty()

    def modal_finish(self, confirm):
        if not self.modal:
            return
        if not confirm and self.focused:
            self.focused.update(self.modal_snapshot)
            self.render(self.focused)
            self.recoord(self.focused)
            self.canvas.itemconfig(self.focused["item"], image=self.focused["photo"])
        self.modal = None
        self.modal_snapshot = None
        self.stop_edge_pan()
        self.refresh_focus_outline()

    def on_delete(self, _event):
        if not self.focused:
            return
        self.modal_finish(False)
        self.canvas.delete(self.focused["item"])
        self.entries.remove(self.focused)
        self.set_focused(None)
        self.mark_dirty()

    # drag & drop -----------------------------------------------------------

    def drop_payloads(self, items):
        payloads = []
        for item in items:
            if item.startswith(("http://", "https://")):
                downloaded = download_image(item)
                if downloaded:
                    payloads.append(downloaded)
                continue
            try:
                data = Path(item).read_bytes()
                pil = Image.open(io.BytesIO(data))
                pil.load()
            except Exception:
                continue
            payloads.append((data, EXTENSIONS.get(pil.format, "jpg"), pil.size))
        return payloads

    def on_drop(self, event):
        world_x, world_y = self.world_at_widget(
            event.x_root - self.canvas.winfo_rootx(),
            event.y_root - self.canvas.winfo_rooty())
        payloads = self.drop_payloads(self.root.tk.splitlist(event.data))
        for offset, (data, ext, size) in enumerate(payloads):
            self.add_entry(data, ext, size,
                           world_x + offset * 30 / self.zoom,
                           world_y + offset * 30 / self.zoom)
        return "copy"

    def drag_payload(self, entry):
        if entry is None:
            return None
        DRAG_CACHE.mkdir(parents=True, exist_ok=True)
        drag_file = DRAG_CACHE / Path(entry["file"]).name
        drag_file.write_bytes(entry["data"])
        return drag_file

    def on_drag_init(self, _event):
        entry = self.focused
        if entry is None:
            entry = self.entry_at(*self.pointer_world())
        drag_file = self.drag_payload(entry)
        if drag_file is None:
            return None
        return ("copy", DND_FILES, str(drag_file))

    # persistence -----------------------------------------------------------

    def save(self, _event=None):
        if self.board_path is None:
            self.board_path = new_board_path(self.query)
        write_refs(self.board_path, self.query, self.entries)
        self.dirty = False
        self.update_title()

    def close(self):
        if self.dirty and tk.messagebox.askyesno("refs", "save board before closing?"):
            self.save()
        self.root.destroy()


def launch(query, entries):
    if os.environ.get("DISPLAY"):
        app = RefBoard(query=query, entries=entries)
        app.root.mainloop()
    else:
        print(write_refs(new_board_path(query), query, entries))


def main():
    parser = argparse.ArgumentParser(prog="refs", description=__doc__.splitlines()[0])
    parser.add_argument("-N", "--count", type=int, default=20,
                        help="number of images to grab (default 20)")
    parser.add_argument("-C", "--columns", type=int, default=4,
                        help="columns in the initial board grid (default 4)")
    parser.add_argument("words", nargs="+",
                        help="query, image files, or path to a BOARD.refs file")
    args = parser.parse_args()
    words = args.words
    if len(words) == 1 and words[0].endswith(".refs"):
        if not os.environ.get("DISPLAY"):
            print("opening a board needs a display", file=sys.stderr)
            sys.exit(1)
        app = RefBoard(board_path=Path(words[0]))
        app.root.mainloop()
    elif all(Path(word).is_file() for word in words):
        launch(Path(words[0]).stem, board_from_files(words))
    else:
        launch(" ".join(words), grab(" ".join(words), args.count, args.columns))


if __name__ == "__main__":
    main()
