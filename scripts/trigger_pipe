#!/usr/bin/env bash
# trigger_pipe — latched fire-and-forget signal; needs no listener, the next
# await_pipe on the same name returns instantly.

help() {
	cat <<'EOF'
trigger_pipe <name> — latch a signal for await_pipe <name>. Never blocks, and
no listener has to be waiting: the next await_pipe <name> returns instantly.

	await_pipe afk &   ... later ...   trigger_pipe afk
	trigger_pipe afk   # fires now, await_pipe afk returns instantly whenever run

Firing again before the latch is awaited re-arms it; one await consumes one
latch. Latches live in ${XDG_RUNTIME_DIR:-/run/user/<uid>}/agent-signals/.
EOF
}

case "${1:-}" in
	-h | --help) help; exit 0 ;;
esac
if [ $# -ne 1 ]; then
	echo "usage: trigger_pipe <name> (see --help)" >&2
	exit 1
fi

name=$1
case "$name" in
	*/*) echo "trigger_pipe: bad pipe name: $name" >&2; exit 1 ;;
esac

flag="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agent-signals/$name.signaled"
mkdir -p "$(dirname "$flag")"
date -u +%FT%TZ >"$flag" # truncate = re-arm when the old latch was never awaited
echo "signaled $flag"
