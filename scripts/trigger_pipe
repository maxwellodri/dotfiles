#!/usr/bin/env bash
# trigger_pipe — fire-and-forget signal to await_pipe on the same pipe name.

help() {
	cat <<'EOF'
trigger_pipe <name> — signal a waiting await_pipe <name>. Never blocks.

	await_pipe afk &   ... later ...   trigger_pipe afk

The signal is dropped (still exit 0) when nobody is waiting: await_pipe owns
pipe creation, and this side never creates or removes it.
EOF
}

case "${1:-}" in
	-h | --help) help; exit 0 ;;
esac
if [ $# -ne 1 ]; then
	echo "usage: trigger_pipe <name> (see --help)" >&2
	exit 1
fi

python3 - "$1" <<'PY'
import os, sys

name = sys.argv[1]
if not name or "/" in name:
    sys.exit(f"trigger_pipe: bad pipe name: {name!r}")

base = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "agent-signals")
path = os.path.join(base, name + ".fifo")
try:
    fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK)  # ENXIO while no reader is attached
except OSError as e:
    print(f"signal dropped ({e.strerror}): nobody is waiting on {path}")
    sys.exit(0)  # fire-and-forget: dropped is a normal outcome, not an error
os.write(fd, b"done\n")
os.close(fd)
print(f"signaled {path}")
PY
