#!/usr/bin/env bash
#
# aria_dl — robust resumable downloader wrapping aria2c.
#
# Replaces the old curl_dl bash retry loop. aria2c gives us, for free:
#   - resume (-c)
#   - infinite retry with backoff (--max-tries=0 --retry-wait=2)
#   - multi-connection downloads (-x16 -s16) for much higher throughput
#   - real HTTP status-code handling (curl without --fail "succeeds" on 404)

while [[ $# -gt 0 ]]; do
  case "$1" in
    # ${2:?...} aborts with a clear message if the arg is missing,
    # which also prevents a runaway loop (shift 2 can't advance otherwise).
    --file)          FILE="${2:?--file requires an argument}";       shift 2 ;;
    --url)           URL="${2:?--url requires an argument}";         shift 2 ;;
    --cookies)       COOKIES="${2:?--cookies requires an argument}"; shift 2 ;;
    --limit)         LIMIT="${2:?--limit requires an argument}";     shift 2 ;;
    --default-limit) LIMIT=500K; shift ;;
    --vps)           VPS=1; shift ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

VPS_HOST=maxwell@odri.xyz      # --vps: aria2c runs here instead of locally
VPS_DL_DIR=/home/maxwell/Downloads  # fallback when block storage isn't attached

if [[ -z "$URL" ]]; then
  echo "Usage: $(basename "$0") --url <url> [--file <file>] [--cookies <file>] [--limit <speed> | --default-limit]" >&2
  echo "  --file          optional: when omitted, aria2c autodetects the name from the URL." >&2
  echo "  --limit <speed> caps bandwidth using aria2c syntax, e.g. '500K', '1M', '2M' (0 = unlimited)." >&2
  echo "  --default-limit shorthand for --limit 500K." >&2
  echo "  --vps           download on the VPS ($VPS_HOST): ~/mount (block storage) if attached, else ~/Downloads;" >&2
  echo "                  with --file, only the basename is kept." >&2
  exit 1
fi

ARIA_ARGS=(
  -c                          # resume partial downloads
  --no-netrc                  # don't read ~/.netrc (auth comes from --cookies)
  --max-tries=0               # retry forever (replaces the old until-loop)
  --retry-wait=2              # 2s backoff between attempts
  -x16 -s16 -k1M              # 16 parallel connections, 1M chunks
  --summary-interval=60       # periodic progress line on long downloads
)

if [[ -n "$VPS" ]]; then
  # ~/mount exists even when the volume is detached; only mountpoint -q proves
  # the block storage is really behind it
  DL_DIR=$(ssh "$VPS_HOST" 'mountpoint -q ~/mount && printf %s ~/mount || printf %s ~/Downloads') || DL_DIR=$VPS_DL_DIR
  ARIA_ARGS+=(-d "$DL_DIR")
  # With --file, only the basename applies; the remote dir is fixed.
  [[ -n "$FILE" ]] && ARIA_ARGS+=(-o "$(basename "$FILE")")
elif [[ -n "$FILE" ]]; then
  # Explicit output path: split into directory + filename for aria2c.
  ARIA_ARGS+=(
    -d "$(dirname "$FILE")"   # output directory
    -o "$(basename "$FILE")"  # output filename
  )
fi

if [[ -n "$LIMIT" ]]; then
  # Cap download throughput so the link isn't saturated while doing other things.
  ARIA_ARGS+=(--max-download-limit="$LIMIT")
fi

if [[ -n "$COOKIES" ]]; then
  if grep -q $'\t' "$COOKIES"; then
    # Netscape cookies.txt format → let aria2c parse it
    if [[ -n "$VPS" ]]; then
      # The cookie file is local; ship it over and clean it up after the run.
      REMOTE_COOKIE="/tmp/aria_dl_cookies.$$"
      scp -q "$COOKIES" "$VPS_HOST:$REMOTE_COOKIE"
      ARIA_ARGS+=(--load-cookies="$REMOTE_COOKIE")
    else
      ARIA_ARGS+=(--load-cookies="$COOKIES")
    fi
  else
    # Raw "name=value; name2=value2" string, as curl_dl used to send it
    ARIA_ARGS+=(--header="Cookie: $(cat "$COOKIES")")
  fi
fi

START=$(date +%s)
if [[ -n "$VPS" ]]; then
  # %q-quote every arg before handing them to the remote shell: ssh joins
  # argv into one command string, and cookie headers contain spaces.
  # shellcheck disable=SC2029 # client-side expansion is the point here
  ssh "$VPS_HOST" "aria2c$(printf ' %q' "${ARIA_ARGS[@]}" "$URL")"
else
  aria2c "${ARIA_ARGS[@]}" "$URL"
fi
RC=$?

if [[ -n "$REMOTE_COOKIE" ]]; then
  ssh "$VPS_HOST" rm -f "$REMOTE_COOKIE"
fi
ELAPSED=$(( $(date +%s) - START ))

# Don't claim success on a failed download.
if (( RC != 0 )); then
  echo "aria2c exited with code $RC after $(date -u -d "@$ELAPSED" +%H:%M:%S)" >&2
  exit "$RC"
fi

format_duration() {
  local s=$1
  if (( s < 60 )); then printf "%ds" "$s"
  elif (( s < 3600 )); then printf "%dm %ds" "$((s / 60))" "$((s % 60))"
  else printf "%dh %dm" "$((s / 3600))" "$(( (s % 3600) / 60 ))"
  fi
}

BODY="Downloaded in ($(format_duration "$ELAPSED"))"
if [[ -n "$TMUX" ]]; then
  SESSION=$(tmux display-message -p '#S')
  BODY="$BODY in tmux session '$SESSION'"
fi

(( ELAPSED >= 30 )) && herald message --title "Download complete" --sound --tag aria_dl --tag work_done "$BODY"
