# SSH config for donnie (NixOS VPS)
# Dotfiles pushes go to the local bare repo (git-mirror hooks it to GitHub):
#   git remote set-url origin maxwell@odri.xyz:source/dotfiles.git

Host localhost
    HostName localhost
    User maxwell

Host github.com
    User git
    #IdentitiesOnly yes
    #IdentityFile ~/.ssh/id_ed25519
