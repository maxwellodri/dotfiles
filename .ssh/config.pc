Host ereader
    HostName 192.168.1.101
    User root
    Port 22

Host vps-socks
    HostName odri.xyz
    User maxwell
    LocalForward 1080 127.0.0.1:1080 #foxyproxy
    LocalForward 3001 127.0.0.1:3001 #youtube-rss
    ExitOnForwardFailure yes
    ServerAliveInterval 30
    ServerAliveCountMax 3
    ConnectTimeout 10
    TCPKeepAlive yes
